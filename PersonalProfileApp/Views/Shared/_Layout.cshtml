@model StudentProfile
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@Model.FullName — @Model.University студенті. Жеке визитка және оқу жобасы." />
    <meta name="theme-color" content="#fff9fb" />
    <title>@ViewData["Title"] · @Model.FullName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Мазмұнға өту</a>
    <header class="site-header shell">
        <a class="brand" asp-controller="Info" asp-action="Index">@Model.FullName<span>жеке парақша</span></a>
        <nav aria-label="Негізгі навигация">
            <a asp-controller="Info" asp-action="Index" aria-current="@(action == "Index" ? "page" : null)">Басты бет</a>
            <a asp-controller="Info" asp-action="About" aria-current="@(action == "About" ? "page" : null)">Мен туралы</a>
            <a asp-controller="Info" asp-action="Portfolio" aria-current="@(action == "Portfolio" ? "page" : null)">Жобам</a>
        </nav>
    </header>
    <main id="main-content" class="shell main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="shell profile-footer">
        <div class="footer-top">
            <div>
                <p class="eyebrow">Қысқаша танысу</p>
                <h2>@Model.FullName</h2>
                <p>@Model.University<br />@Model.Specialty · @Model.Group</p>
            </div>
            <section aria-labelledby="skills-heading">
                <h2 id="skills-heading" class="small-heading">Үйреніп жүргенім</h2>
                <ul class="skills">
                    @foreach (var skill in Model.Skills)
                    {
                        <li>@skill</li>
                    }
                </ul>
            </section>
            <section class="contacts" aria-labelledby="contact-heading">
                <h2 id="contact-heading" class="small-heading">Байланыс</h2>
                <a href="mailto:@Model.Email">@Model.Email</a>
                <a href="@Model.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub профилім ↗<span class="sr-only"> (жаңа бетте ашылады)</span></a>
            </section>
        </div>
        <div class="footer-bottom"><span>@Model.FullName · Студенттік портфолио</span><span>@Model.Group</span></div>
    </footer>
</body>
</html>
